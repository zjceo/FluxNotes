{
  "expo": {
    "name": "FluxNotes",
    "slug": "fluxnotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zjceo.fluxnotes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "fluxnotes",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1d1f9afd-6939-4c90-b466-8977ccfab6d5"
      }
    },
    "owner": "jczap"
  }
}
